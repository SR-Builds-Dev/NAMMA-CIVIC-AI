# NAMMA CIVIC AI - Environment Configuration Example
# Copy this file to .env and provide your credentials when ready for live production.

# 1. Supabase Backend (Optional for live PostgreSQL & Real Auth)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-publishable-key-here

# 2. Google OAuth 2.0 (Optional for live Google Sign-In)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# 3. AI Vision & LLM Endpoint (Optional for direct Gemini/Cloud Vision APIs)
VITE_AI_API_ENDPOINT=https://api.nammacivic.ai/v1/analyze
VITE_AI_API_KEY=your-ai-api-key-here

# 4. Public Deployment Domain (Used for QR code generation)
VITE_PUBLIC_APP_URL=https://namma-civic-ai.vercel.app
